              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "start_date": {
              "default": "1900-01-01T00:00:00Z",
              "description": "ISO 8601 UTC timestamp (e.g. ``\"2023-01-01T00:00:00Z\"``); only\npackages modified on/after this date are returned.",
              "type": "string"
            }
          },
          "required": [
            "collection"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
