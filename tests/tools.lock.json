        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "full-text query, e.g. ``\"unmanned aircraft\"``.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "us_search_cfr_sections",
