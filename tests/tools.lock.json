    "us_search_case_law": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Full-text search over 8M+ US court opinions (CourtListener, keyless).\n\nThe headline value is STATE case law - no other tool in this server covers\nstate courts. Federal courts are searchable too, but dedicated\nCourtListener MCP wrappers exist for heavy federal case-law work.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "court": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional CourtListener court id to scope the search, e.g.\n``\"cal\"`` (California Supreme Court), ``\"ny\"`` (NY Court of\nAppeals), ``\"texapp\"`` (Texas Court of Appeals), ``\"scotus\"``."
            },
            "limit": {
              "default": 20,
              "description": "max results (default 20; the API returns 20 per page).",
              "type": "integer"
            },
            "query": {
              "description": "full-text query, e.g. ``\"negligence standard of care\"``.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "us_search_case_law",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "c25d6090233a095a5ebddb339a978a2cae58c8716f1852757c2f620f864a1831"
    },
